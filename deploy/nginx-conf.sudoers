# Install as /etc/sudoers.d/nginx-conf with mode 0440.
# Keep this file narrow: no shell, no broad wildcards.

User_Alias NGINX_CONF_APP = nginx-config

Cmnd_Alias NGINX_CONF_NGINX = /usr/sbin/nginx -t, /bin/systemctl reload nginx
Cmnd_Alias NGINX_CONF_CERTBOT = /usr/bin/certbot renew --dry-run --non-interactive
Cmnd_Alias NGINX_CONF_HELPER = \
    /usr/local/lib/nginx-conf/nginx-conf-helper activate-config, \
    /usr/local/lib/nginx-conf/nginx-conf-helper deactivate-config, \
    /usr/local/lib/nginx-conf/nginx-conf-helper write-config, \
    /usr/local/lib/nginx-conf/nginx-conf-helper reset-config-to-head, \
    /usr/local/lib/nginx-conf/nginx-conf-helper commit-config, \
    /usr/local/lib/nginx-conf/nginx-conf-helper clone-project

NGINX_CONF_APP ALL=(root) NOPASSWD: NGINX_CONF_NGINX, NGINX_CONF_CERTBOT, NGINX_CONF_HELPER
