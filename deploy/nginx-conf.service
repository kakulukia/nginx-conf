[Unit]
Description=Nginx configuration admin app
After=network-online.target pm2-nginx-config.service
Wants=network-online.target pm2-nginx-config.service

[Service]
Type=simple
User=nginx-config
Group=nginx-config
WorkingDirectory=/opt/nginx-conf
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/opt/nginx-config
Environment=PM2_HOME=/opt/nginx-config/.pm2
Environment=PATH=/opt/nginx-conf/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/nginx-conf/.venv/bin/uvicorn nginx_conf.main:app --app-dir /opt/nginx-conf/src --host 127.0.0.1 --port 8080 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
# Sudo needs privilege elevation; Unix permissions still protect root-owned files.
NoNewPrivileges=false
# Managed Gunicorn sockets must be visible to the host Nginx service.
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nginx-config /opt/www /etc/nginx /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /var/log/nginx /run/sudo

[Install]
WantedBy=multi-user.target
