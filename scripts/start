#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_UVICORN="$ROOT_DIR/.venv/bin/uvicorn"

if [[ ! -x "$VENV_UVICORN" ]]; then
  echo "Fehlt: $VENV_UVICORN" >&2
  echo "Einmal ausführen: uv sync --extra dev" >&2
  exit 1
fi

cd "$ROOT_DIR"

exec "$VENV_UVICORN" \
  nginx_conf.main:app \
  --app-dir src \
  --host "${HOST:-127.0.0.1}" \
  --port "${PORT:-8000}" \
  --reload
